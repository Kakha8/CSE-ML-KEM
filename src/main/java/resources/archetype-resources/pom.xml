<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>java-rust-demo</artifactId>
  <version>1.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>

        <executions>
          <!-- Build Rust automatically during Maven build -->
          <execution>
            <id>build-rust</id>
            <phase>generate-resources</phase>

            <goals>
              <goal>exec</goal>
            </goals>

            <configuration>
              <workingDirectory>
                ${project.basedir}/native-rust
              </workingDirectory>

              <executable>cargo</executable>

              <arguments>
                <argument>build</argument>
              </arguments>
            </configuration>
          </execution>

          <!-- Start Java in a separate JVM -->
          <execution>
            <id>run-java</id>

            <goals>
              <goal>exec</goal>
            </goals>

            <configuration>
              <executable>${java.home}/bin/java</executable>

              <arguments>
                <argument>
                  -Djava.library.path=${project.basedir}/native-rust/target/debug
                </argument>

                <argument>-classpath</argument>
                <classpath/>

                <argument>com.example.App</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>